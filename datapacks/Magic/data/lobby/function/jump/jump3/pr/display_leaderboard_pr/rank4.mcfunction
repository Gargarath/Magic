## appelée par interact_with_interaction/check_clicked_button si @s clique pour avoir les stats du rankX
# permet d'afficher les données du rank X

$execute if data storage stats:jump 3.rank4{name:""} run return run tellraw @s [{"color":"gray","text":"* "},{"text":"$(tr_jump_leaderboard_no_data)","color":"gray"},{"color":"gray","text":" *"}]
# si le storage est vide -> annule et renvoi aucune donnée

$tellraw @s [{"color":"gold","text":"\n-- "},{"text":"$(tr_jump_leaderboard_title_1)","color":"gold"},{"text":"4. ","color":"yellow"},{"color":"white","interpret":true,"nbt":"3.rank4.head","storage":"stats:jump"}," ",{"color":"green","interpret":true,"nbt":"3.rank4.name","storage":"stats:jump"},{"color":"red","text":" "},{"text":"$(tr_jump_leaderboard_title_2)","color":"red"},{"color":"red","text":" n\u00B03"},{"color":"gold","text":" --"}]

$tellraw @s [{"text":"$(tr_jump_leaderboard_best_time)"},{"text":" "},{"color":"green","nbt":"3.rank4.min10","storage":"stats:jump","plain":true},{"color":"green","nbt":"3.rank4.min01","storage":"stats:jump","plain":true},{"color":"white","text":":"},{"color":"green","nbt":"3.rank4.sec10","storage":"stats:jump","plain":true},{"color":"green","nbt":"3.rank4.sec01","storage":"stats:jump","plain":true},{"color":"white","text":":"},{"color":"green","nbt":"3.rank4.dec10","storage":"stats:jump","plain":true},{"color":"green","nbt":"3.rank4.dec01","storage":"stats:jump","plain":true}," - ",{"color":"green","nbt":"3.rank4.fall_pr","storage":"stats:jump","plain":true},{"text":" "},{"text":"$(tr_jump_leaderboard_fall)"}]

execute store result score #tmp jump3_cp1 run data get storage stats:jump 3.rank4.cp1.time
