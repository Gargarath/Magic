## appelée par display_shop_tab quand on est en FFA
# affiche les options exclusives au FFA

# Passive income coins
$execute at @n[type=item_display,tag=optn_menu_background] run summon text_display ~3.64 ~0.48 ~1.79 {billboard:"fixed",alignment:"left",see_through:0b,shadow:0b,Rotation:[0F,0F],Tags:["optn_menu","optn_menu_shop","optn_menu_shop_clickable","optn_menu_ffa_passive_money"],transformation:{left_rotation:[0f,0f,0f,1f],right_rotation:[0f,0f,0f,1f],translation:[0f,0f,0f],scale:[1.3f,1.5f,1.3f]},text:[{"text":"                                                               \n\n"},{"bold":true,"color":"white","text":"$(tr_optn_menu_ffa_passive_money)"}],background:0}
execute at @n[tag=optn_menu_background] run summon item_display ~1.90 ~-0.27 ~1.82 {billboard:"fixed",item_display:"head",Tags:["optn_menu","optn_menu_shop","optn_menu_shop_clickable","optn_menu_ffa_passive_money"],glow_color_override:16701501,transformation:{left_rotation:[0f,0f,0f,1f],right_rotation:[0f,0f,0f,1f],translation:[0f,0f,0f],scale:[2.9f,0.5f,0.1f]},item:{id:"minecraft:oak_sign",count:1,components:{"minecraft:custom_model_data":{strings:["generic_value_selector_0"]}}}}
execute at @n[type=item_display,tag=optn_menu_ffa_passive_money] run summon interaction ~-1.18 ~0.15 ~-0.2 {width:0.5f,height:0.5,response:1b,Tags:["optn_menu","optn_menu_ffa_passive_money_left","optn_menu_shop_clickable","optn_menu_clickable"]}
execute at @n[type=item_display,tag=optn_menu_ffa_passive_money] run summon interaction ~-0.68 ~0.15 ~-0.2 {width:0.5f,height:0.5,response:1b,Tags:["optn_menu","optn_menu_ffa_passive_money_center","optn_menu_shop_clickable","optn_menu_clickable","optn_menu_left_clickable"]}
execute at @n[type=item_display,tag=optn_menu_ffa_passive_money] run summon interaction ~-0.18 ~0.15 ~-0.2 {width:0.5f,height:0.5,response:1b,Tags:["optn_menu","optn_menu_ffa_passive_money_center","optn_menu_shop_clickable","optn_menu_clickable","optn_menu_left_clickable"]}
execute at @n[type=item_display,tag=optn_menu_ffa_passive_money] run summon interaction ~0.32 ~0.15 ~-0.2 {width:0.5f,height:0.5,response:1b,Tags:["optn_menu","optn_menu_ffa_passive_money_center","optn_menu_shop_clickable","optn_menu_clickable","optn_menu_left_clickable"]}
execute at @n[type=item_display,tag=optn_menu_ffa_passive_money] run summon interaction ~0.77 ~0.15 ~-0.2 {width:0.4f,height:0.5,response:1b,Tags:["optn_menu","optn_menu_ffa_passive_money_right","optn_menu_shop_clickable","optn_menu_clickable"]}
execute at @n[type=item_display,tag=optn_menu_ffa_passive_money] run summon interaction ~1.23 ~0.15 ~-0.2 {width:0.5f,height:0.5,response:1b,Tags:["optn_menu","optn_menu_ffa_passive_money_custom","optn_menu_shop_clickable","optn_menu_clickable"]}
execute as @n[type=item_display,tag=optn_menu_ffa_passive_money] at @s run summon text_display ~-0.2 ~0.28 ~0.01 {billboard:"fixed",alignment:"center",Tags:["optn_menu","optn_menu_shop_clickable","optn_menu_button_ffa_passive_money"],transformation:{left_rotation:[0f,0f,0f,1f],right_rotation:[0f,0f,0f,1f],translation:[0f,0f,0f],scale:[1f,1f,1f]},text:{"bold":true,"color":"black","text":""},background:0}
execute unless score $passive_money option_panel matches 1..50 run scoreboard players set $passive_money option_panel 10
execute store result storage temp temp int 1 run scoreboard players get $passive_money option_panel
data modify storage lobby:language translate merge from storage temp
function lobby:option_panel/pages/shop/ffa_economy/passive_money/display with storage lobby:language translate

