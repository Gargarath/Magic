$execute if score $type secondary_objective_slot matches 0 run bossbar set secondary_objective:viewer$(slot) color yellow
$execute if score $type secondary_objective_slot matches 2 run bossbar set secondary_objective:viewer$(slot) color red
$execute if score $type secondary_objective_slot matches 5 run bossbar set secondary_objective:viewer$(slot) color green
$execute if score $type secondary_objective_slot matches 6 run bossbar set secondary_objective:viewer$(slot) color pink
$execute if score on point_capture matches 1 if score state point_capture matches 0 run bossbar set secondary_objective:viewer$(slot) color white
$execute if score on point_capture matches 1 if score state point_capture matches 1 run bossbar set secondary_objective:viewer$(slot) color blue
$execute if score on point_capture matches 1 if score state point_capture matches 2 run bossbar set secondary_objective:viewer$(slot) color red
