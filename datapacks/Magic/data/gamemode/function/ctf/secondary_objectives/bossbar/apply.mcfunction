## appelée par gamemode:ctf/secondary_objectives/bossbar/sync_player avec le storage secondaire_objective:temp
# permet de configurer le nom traduit, la couleur et le style de la bossbar individuelle de @s

$bossbar set secondary_objective:viewer$(slot) value $(value)
$bossbar set secondary_objective:viewer$(slot) max $(max)
$bossbar set secondary_objective:viewer$(slot) players @s
$bossbar set secondary_objective:viewer$(slot) style progress

$execute if score $type secondary_objective_slot matches 0 run bossbar set secondary_objective:viewer$(slot) name {"text":"$(tr_secondary_objective_countdown)","color":"gold","bold":true}
$execute if score $type secondary_objective_slot matches 2 run bossbar set secondary_objective:viewer$(slot) name {"text":"$(tr_secondary_objective_lich)","color":"gray","bold":true}
$execute if score $type secondary_objective_slot matches 5 run bossbar set secondary_objective:viewer$(slot) name {"text":"$(tr_secondary_objective_guardian)","color":"green","bold":true}
$execute if score $type secondary_objective_slot matches 6 run bossbar set secondary_objective:viewer$(slot) name {"text":"$(tr_secondary_objective_cherry)","color":"light_purple","bold":true}

$execute unless entity @s[team=red] if score $type secondary_objective_slot matches 1 run bossbar set secondary_objective:viewer$(slot) name ["",{"nbt":"blue_score1","storage":"minecraft:point_capture","interpret":true},{"nbt":"blue_score2","storage":"minecraft:point_capture","interpret":true},{"nbt":"blue_score3","storage":"minecraft:point_capture","interpret":true},{"nbt":"blue_score4","storage":"minecraft:point_capture","interpret":true},{"text":" - ","bold":true,"color":"gray"},{"text":"$(tr_secondary_objective_pirate)","bold":true,"color":"gold"},{"text":" - ","bold":true,"color":"gray"},{"nbt":"red_score1","storage":"minecraft:point_capture","interpret":true},{"nbt":"red_score2","storage":"minecraft:point_capture","interpret":true},{"nbt":"red_score3","storage":"minecraft:point_capture","interpret":true},{"nbt":"red_score4","storage":"minecraft:point_capture","interpret":true}]
