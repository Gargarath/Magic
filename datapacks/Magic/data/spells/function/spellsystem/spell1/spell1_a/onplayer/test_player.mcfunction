# appelée par spells:loop si une flèche explosive est dans un joueur
# permet de fair une explosion selon à qui la flèche appartient

execute if data entity @s {active_effects:[{amplifier:1b,id:"minecraft:luck"}]} at @s run function spells:spellsystem/spell1/spell1_a/onplayer/player1
