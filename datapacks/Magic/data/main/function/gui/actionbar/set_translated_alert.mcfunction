## appelée par les alertes de gameplay, les fins de cooldown et les changements de langue
# permet de reconstruire l'alerte d'actionbar de @s depuis ses traductions personnelles

$execute if score @s gui_actionbar_message matches 1 run data modify storage gui player.$(player).actionbar.alert set value {"text":"$(tr_actionbar_next_explosive_arrow) ","color":"dark_red","bold":false}
$execute if score @s gui_actionbar_message matches 2 run data modify storage gui player.$(player).actionbar.alert set value {"text":"$(tr_actionbar_next_freeze_arrow) ","color":"aqua","bold":false}
