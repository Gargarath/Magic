## Affiche l'état de l'option du son de fin de cooldown.

# son désactivé
$execute if score @s opt_cd_ready_sound matches 0 run item replace entity @s inventory.5 with oak_sign[item_name=[{"color":"aqua","text":"$(tr_inventory_menu_settings_cd_ready_sound)"}],lore=["",{"color":"gray","text":"> $(tr_inventory_menu_settings_cd_ready_sound_subtitle_1)"},{"color":"gray","text":"$(tr_inventory_menu_settings_cd_ready_sound_lore_1)"},{"color":"gray","text":"$(tr_inventory_menu_settings_cd_ready_sound_lore_2)"},"",{"color":"red","text":"> $(tr_inventory_menu_settings_cd_ready_sound_subtitle_2)"},{"color":"gray","text":"$(tr_inventory_menu_settings_cd_ready_sound_lore_3)"},{"color":"gray","text":"$(tr_inventory_menu_settings_cd_ready_sound_lore_4)"}],custom_data={inventory_menu:1b,inventory_menu_settings_cd_ready_sound:1b},custom_model_data={strings:["inventory_settings_cd_ready_sound_off"]}] 1

# son activé
$execute if score @s opt_cd_ready_sound matches 1 run item replace entity @s inventory.5 with oak_sign[item_name=[{"color":"aqua","text":"$(tr_inventory_menu_settings_cd_ready_sound)"}],lore=["",{"color":"green","text":"> $(tr_inventory_menu_settings_cd_ready_sound_subtitle_1)"},{"color":"gray","text":"$(tr_inventory_menu_settings_cd_ready_sound_lore_1)"},{"color":"gray","text":"$(tr_inventory_menu_settings_cd_ready_sound_lore_2)"},"",{"color":"gray","text":"> $(tr_inventory_menu_settings_cd_ready_sound_subtitle_2)"},{"color":"gray","text":"$(tr_inventory_menu_settings_cd_ready_sound_lore_3)"},{"color":"gray","text":"$(tr_inventory_menu_settings_cd_ready_sound_lore_4)"}],custom_data={inventory_menu:1b,inventory_menu_settings_cd_ready_sound:1b},custom_model_data={strings:["inventory_settings_cd_ready_sound_on"]}] 1
