## Affiche l'état de l'option des notifications de revenu passif.

# notifications désactivées
$execute if score @s opt_passive_income_alert matches 0 run item replace entity @s inventory.4 with oak_sign[item_name=[{"color":"gold","text":"$(tr_inventory_menu_settings_passive_income_alert)"}],lore=["",{"color":"gray","text":"> $(tr_inventory_menu_settings_passive_income_alert_subtitle_1)"},{"color":"gray","text":"$(tr_inventory_menu_settings_passive_income_alert_lore_1)"},{"color":"gray","text":"$(tr_inventory_menu_settings_passive_income_alert_lore_2)"},"",{"color":"red","text":"> $(tr_inventory_menu_settings_passive_income_alert_subtitle_2)"},{"color":"gray","text":"$(tr_inventory_menu_settings_passive_income_alert_lore_3)"},{"color":"gray","text":"$(tr_inventory_menu_settings_passive_income_alert_lore_4)"}],custom_data={inventory_menu:1b,inventory_menu_settings_passive_income_alert:1b},custom_model_data={strings:["inventory_settings_passive_income_alert_off"]}] 1

# notifications activées
$execute if score @s opt_passive_income_alert matches 1 run item replace entity @s inventory.4 with oak_sign[item_name=[{"color":"gold","text":"$(tr_inventory_menu_settings_passive_income_alert)"}],lore=["",{"color":"green","text":"> $(tr_inventory_menu_settings_passive_income_alert_subtitle_1)"},{"color":"gray","text":"$(tr_inventory_menu_settings_passive_income_alert_lore_1)"},{"color":"gray","text":"$(tr_inventory_menu_settings_passive_income_alert_lore_2)"},"",{"color":"gray","text":"> $(tr_inventory_menu_settings_passive_income_alert_subtitle_2)"},{"color":"gray","text":"$(tr_inventory_menu_settings_passive_income_alert_lore_3)"},{"color":"gray","text":"$(tr_inventory_menu_settings_passive_income_alert_lore_4)"}],custom_data={inventory_menu:1b,inventory_menu_settings_passive_income_alert:1b},custom_model_data={strings:["inventory_settings_passive_income_alert_on"]}] 1
