# appelée par stuff:stuffarcher si @s possède à la fois la flèche explosive et la flèche de glace
# permet à @s de récuperer la bonne flèche de glace explosive selon son numéro de joueur

$item replace entity @s hotbar.$(slot_arrows) with tipped_arrow[custom_name={"bold":true,"color":"gold","text":"$(tr_archer_explosive_ice_arrow_1_name)"},lore=[{"color":"gray","text":"$(tr_archer_explosive_ice_arrow_1_lore_1)"},{"color":"gray","text":"$(tr_archer_explosive_ice_arrow_1_lore_2)"},{"color":"gray","text":"$(tr_archer_explosive_ice_arrow_1_lore_3) X"},{"color":"gray","text":"$(tr_archer_explosive_ice_arrow_1_lore_4) X"},{"color":"gray","text":"$(tr_archer_explosive_ice_arrow_1_lore_5)"}],potion_contents={potion:"minecraft:thick",custom_color:16748060,custom_effects:[{id:"minecraft:unluck",amplifier:$(player),duration:200,show_particles:0b,show_icon:0b},{id:"minecraft:luck",amplifier:$(player),duration:200,show_particles:0b,show_icon:0b}]},tooltip_display={hidden_components:["potion_contents"]},custom_data={arrows_slot:1b}] 1