## appelé quand @s a besoin de flèches inutilisables
## lui donne des flèches inutilisables

clear @s arrow
clear @s stick

$item replace entity @s[scores={arrow=1,weapon1=0..,Player=1..},tag=archer] hotbar.$(slot_arrows) with stick[custom_name="$(tr_archer_classic_arrow_1_name)",lore=[{"color":"gray","text":"$(tr_archer_classic_arrow_1_lore_1)"},{"color":"gray","text":"$(tr_archer_classic_arrow_1_lore_2)"},{"color":"gray","text":"$(tr_archer_classic_arrow_1_lore_3)"},{"color":"gray","text":"$(tr_archer_classic_arrow_1_lore_4)"}],custom_data={arrows_slot:1b},custom_model_data={strings:["unusable_arrow"]}] 1
