# appelée par stuff:stuffarcher si @s possède la flèche explosive
# permet à @s de récuperer la bonne flèche explosive selon son numéro de joueur

$item replace entity @s hotbar.$(slot_arrows) with tipped_arrow[custom_name={"bold":true,"color":"dark_red","text":"$(tr_archer_explosive_arrow_2_name)"},lore=[{"color":"gray","text":"$(tr_archer_explosive_arrow_2_lore_1)"},{"color":"gray","text":"$(tr_archer_explosive_arrow_2_lore_2)"},{"color":"gray","text":"$(tr_archer_explosive_arrow_2_lore_3)"},{"color":"gray","text":"$(tr_archer_explosive_arrow_2_lore_4)"},{"color":"gray","text":"$(tr_archer_explosive_arrow_2_lore_5)"},{"color":"gray","text":"$(tr_archer_explosive_arrow_2_lore_6)"},{"color":"gray","text":"$(tr_archer_explosive_arrow_2_lore_7)"},{"color":"gray","text":"$(tr_archer_explosive_arrow_2_lore_8)"}],potion_contents={potion:"minecraft:thick",custom_color:16711680,custom_effects:[{id:"minecraft:luck",amplifier:$(player),duration:200,show_particles:0b,show_icon:0b}]},tooltip_display={hidden_components:["potion_contents"]},custom_data={arrows_slot:1b}] 1