$execute if entity @s[tag=red_team] run function main:stats/stats_book/playerx/change_to_red {player:"$(player)"}
# si @s est rouge -> change sa page 1

$execute if data storage stats:leaderboards by_player.$(player).kd_ratio.positive run function main:stats/stats_book/playerx/ratio_positive {player:"$(player)"}
$execute if data storage stats:leaderboards by_player.$(player).kd_ratio.big run function main:stats/stats_book/playerx/ratio_big {player:"$(player)"}
# si @s a un ratio positif ou grand -> change la couleur dans sa page 2

$data merge block 14 97 13 {front_text:{messages:[[{"text":"Statistiques de ","color":"gold","bold":true},{"nbt":"by_player.$(player).name","storage":"stats:leaderboards","interpret":true,"color":"white","bold":true}],"","",""]}}
$data modify block 13 97 13 Items[{Slot:$(player)b}].components."minecraft:custom_name" set from block 14 97 13 front_text.messages[0]
# change le nom du livre

$item replace entity @s hotbar.8 from block 13 97 13 container.$(player)
# copie le livre du slot de joueur 1 dans l'inventaire de @s