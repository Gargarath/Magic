## appelée par main:stats_book/create_stat_books
## permet de créer le stat_book du joueur X selon son numéro de joueur

## appelée avec un argument {player:"X"}

$execute store result storage stats:leaderboards by_player."$(player)".stat_kd_ratio1000 int 1 run scoreboard players get @s stat_kd_ratio1000
$execute store result storage stats:leaderboards by_player."$(player)".stat_killcount int 1 run scoreboard players get @s stat_killcount
$execute store result storage stats:leaderboards by_player."$(player)".stat_deathcount int 1 run scoreboard players get @s stat_deathcount
$execute store result storage stats:leaderboards by_player."$(player)".stat_total_dmg int 1 run scoreboard players get @s stat_total_dmg
$execute store result storage stats:leaderboards by_player."$(player)".stat_dmg_taken int 1 run scoreboard players get @s stat_dmg_taken
$execute store result storage stats:leaderboards by_player."$(player)".stat_killcount_player int 1 run scoreboard players get @s stat_killcount_player
$execute store result storage stats:leaderboards by_player."$(player)".stat_killcount_boss int 1 run scoreboard players get @s stat_killcount_boss
$execute store result storage stats:leaderboards by_player."$(player)".stat_hand_dmg int 1 run scoreboard players get @s stat_hand_dmg
$execute store result storage stats:leaderboards by_player."$(player)".stat_spell_dmg int 1 run scoreboard players get @s stat_spell_dmg
$execute store result storage stats:leaderboards by_player."$(player)".stat_bow_dmg10 int 1 run scoreboard players get @s stat_bow_dmg10
$execute store result storage stats:leaderboards by_player."$(player)".stat_usespell int 1 run scoreboard players get @s stat_usespell
$execute store result storage stats:leaderboards by_player."$(player)".stat_flag_earned int 1 run scoreboard players get @s stat_flag_earned
$execute store result storage stats:leaderboards by_player."$(player)".stat_flag_cap int 1 run scoreboard players get @s stat_flag_cap
$execute store result storage stats:leaderboards by_player."$(player)".stat_flag_saved int 1 run scoreboard players get @s stat_flag_saved

