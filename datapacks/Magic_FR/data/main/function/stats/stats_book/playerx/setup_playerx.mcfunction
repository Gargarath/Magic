execute if entity @s[tag=red_team] run function main:stats/stats_book/playerx/change_to_red with entity @s EnderItems[0].components.minecraft:custom_data
# si @s est rouge -> change sa page 1

$execute if data storage stats:leaderboards by_player.$(player_last_game).kd_ratio.positive run function main:stats/stats_book/playerx/ratio_positive with entity @s EnderItems[0].components.minecraft:custom_data
$execute if data storage stats:leaderboards by_player.$(player_last_game).kd_ratio.big run function main:stats/stats_book/playerx/ratio_big with entity @s EnderItems[0].components.minecraft:custom_data
# si @s a un ratio positif ou grand -> change la couleur dans sa page 2

$data merge block 14 97 13 {front_text:{messages:[[{"text":"$(tr_stats_book_name) ","color":"gold","bold":true},{"nbt":"by_player.$(player_last_game).name","storage":"stats:leaderboards","interpret":true,"color":"white","bold":true}],"","",""]}}
$data modify block 13 97 13 Items[{Slot:$(player_last_game)b}].components."minecraft:custom_name" set from block 14 97 13 front_text.messages[0]
# change le nom du livre

$item replace entity @s hotbar.8 from block 13 97 13 container.$(player_last_game)
# copie le livre du slot de joueur X dans l'inventaire de @s