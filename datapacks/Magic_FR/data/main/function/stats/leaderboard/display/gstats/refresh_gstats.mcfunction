# appelée par sort_final_score et par les changement de mode de jeu
# refresh l'affichage des gstat selon le mode et la stat


$data merge entity @n[type=minecraft:text_display,tag=leaderboard_warrior_title_mode] {text:{"bold":false,"color":"gray","text":"en $(mode)"}}
$data merge entity @n[type=minecraft:text_display,tag=leaderboard_warrior_5] {text:[{"bold":true,"color":"yellow","text":"5. "},{"color":"white","interpret":true,"nbt":"$(mode).$(stat).warrior.5.head","storage":"stats:global"}," ",{"color":"green","nbt":"$(mode).$(stat).warrior.5.name","storage":"stats:global"},{"color":"gray","text":" - "},{"color":"yellow","nbt":"$(mode).$(stat).warrior.5.score","storage":"stats:global","plain":true}]}
