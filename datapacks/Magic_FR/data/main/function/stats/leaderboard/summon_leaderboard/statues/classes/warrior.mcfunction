## appelée par summon_statues
# invoque la statue da la position en question

summon mannequin ~ ~ ~ {Rotation:[90F,0F],NoGravity:1b,Silent:1b,Invulnerable:1b,PersistenceRequired:1b,immovable:true,hide_description:true,Tags:["leaderboard_gstatues","leaderboard_place_warrior"],attributes:[{id:"minecraft:scale",base:4.0}],hidden_layers:["cape"],profile:{texture:"skins/warrior_master"}}
# invoque la statue

execute as @e[type=minecraft:mannequin,limit=1,distance=..1] at @s run summon text_display ~-1 ~3.1 ~ {Rotation:[90F,0F],billboard:"horizontal",Tags:["leaderboard_gstatues","leaderboard_warrior_title"],transformation:{left_rotation:[0f,0f,0f,1f],right_rotation:[0f,0f,0f,1f],translation:[0f,0f,0f],scale:[0.8f,0.8f,0.8f]},text:{"bold":true,"color":"gold","text":"Meilleurs Guerriers"}}
execute as @e[type=minecraft:mannequin,limit=1,distance=..1] at @s run summon text_display ~-1 ~2.9 ~ {Rotation:[90F,0F],billboard:"horizontal",Tags:["leaderboard_gstatues","leaderboard_warrior_title"],transformation:{left_rotation:[0f,0f,0f,1f],right_rotation:[0f,0f,0f,1f],translation:[0f,0f,0f],scale:[0.8f,0.8f,0.8f]},text:{"bold":false,"color":"gray","text":"par score final"}}
