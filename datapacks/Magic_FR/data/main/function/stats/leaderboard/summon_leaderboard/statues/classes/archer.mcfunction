## appelée par summon_statues
# invoque la statue da la position en question

summon mannequin ~ ~ ~ {Rotation:[90F,0F],NoGravity:1b,Silent:1b,Invulnerable:1b,PersistenceRequired:1b,immovable:true,hide_description:true,Tags:["leaderboard_gstatues","leaderboard_place_archer"],attributes:[{id:"minecraft:scale",base:4.0}],hidden_layers:["cape"],profile:{texture:"skins/archer_master"}}
# invoque la statue

execute as @n[type=minecraft:mannequin] at @s run summon text_display ~-1 ~3.1 ~ {background:16777215,shadow:1b,Rotation:[90F,0F],billboard:"horizontal",Tags:["leaderboard_gstatues","leaderboard_archer_title"],transformation:{left_rotation:[0f,0f,0f,1f],right_rotation:[0f,0f,0f,1f],translation:[0f,0f,0f],scale:[0.8f,0.8f,0.8f]},text:{"bold":true,"color":"dark_green","text":"Meilleurs Archers"}}
execute as @n[type=minecraft:mannequin] at @s run summon text_display ~-1 ~2.9 ~ {background:16777215,shadow:1b,Rotation:[90F,0F],billboard:"horizontal",Tags:["leaderboard_gstatues","leaderboard_archer_title"],transformation:{left_rotation:[0f,0f,0f,1f],right_rotation:[0f,0f,0f,1f],translation:[0f,0f,0f],scale:[0.8f,0.8f,0.8f]},text:{"bold":false,"color":"gray","text":"par score total"}}
$execute as @n[type=minecraft:mannequin] at @s run summon text_display ~-1 ~2.7 ~ {background:16777215,shadow:1b,Rotation:[90F,0F],billboard:"horizontal",Tags:["leaderboard_gstatues","leaderboard_archer_title","leaderboard_archer_title_mode"],transformation:{left_rotation:[0f,0f,0f,1f],right_rotation:[0f,0f,0f,1f],translation:[0f,0f,0f],scale:[0.8f,0.8f,0.8f]},text:{"bold":false,"color":"gray","text":"en $(mode)"}}
# invoque les titres

$execute as @n[type=minecraft:mannequin] at @s run summon text_display ~-1 ~2.3 ~ {background:16777215,shadow:1b,Rotation:[90F,0F],billboard:"horizontal",Tags:["leaderboard_gstatues","leaderboard_archer_1"],transformation:{left_rotation:[0f,0f,0f,1f],right_rotation:[0f,0f,0f,1f],translation:[0f,0f,0f],scale:[0.8f,0.8f,0.8f]},text:[{"bold":true,"color":"yellow","text":"1. "},{"color":"white","interpret":true,"nbt":"$(mode).$(stat).archer.1.head","storage":"stats:global"}," ",{"color":"green","interpret":true,"nbt":"$(mode).$(stat).archer.1.name","storage":"stats:global"},{"color":"gray","text":" - "},{"color":"yellow","score":{"name":"$rank1","objective":"gstat_archer_score"}}]}
