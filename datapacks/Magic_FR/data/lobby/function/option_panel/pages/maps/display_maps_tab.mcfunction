## appelée par interact_with_menu/check_clicked_button si un modo à cliqué sur le menu arènes
# permet d'afficher le menu -> arènes

function lobby:option_panel/pages/setup_clickable
kill @e[type=interaction,tag=optn_menu_maps_tab]
# setup les boutons dynamique

            ## BACKGROUND
data merge entity @e[type=item_display,tag=optn_menu_background,limit=1] {item:{components:{"minecraft:custom_model_data":{strings:["maps_tab"]}}}}

            ## MAP SELECTION
execute if score $random map_selection matches 0 at @e[tag=optn_menu_background,limit=1] run summon item_display ~-3.65 ~1.9 ~1.765 {billboard:"fixed",item_display:"head",Tags:["optn_menu","optn_menu_maps","optn_menu_maps_clickable","optn_menu_maps_map_selection"],glow_color_override:16701501,transformation:{left_rotation:[0f,0f,0f,1f],right_rotation:[0f,0f,0f,1f],translation:[0f,0f,0f],scale:[1.5f,1.5f,1.5f]},item:{id:"minecraft:oak_sign",count:1,components:{"minecraft:custom_model_data":{strings:["map_selection_predefined"]}}}}
execute if score $random map_selection matches 1..2 at @e[tag=optn_menu_background,limit=1] run summon item_display ~-3.65 ~1.9 ~1.765 {billboard:"fixed",item_display:"head",Tags:["optn_menu","optn_menu_maps","optn_menu_maps_clickable","optn_menu_maps_map_selection"],glow_color_override:16701501,transformation:{left_rotation:[0f,0f,0f,1f],right_rotation:[0f,0f,0f,1f],translation:[0f,0f,0f],scale:[1.5f,1.5f,1.5f]},item:{id:"minecraft:oak_sign",count:1,components:{"minecraft:custom_model_data":{strings:["map_selection_random"]}}}}

            ## RANDOM LVL
execute if score $block_same_map map_selection matches 0 at @e[tag=optn_menu_background,limit=1] run summon item_display ~0.5 ~1.9 ~1.765 {billboard:"fixed",item_display:"head",Tags:["optn_menu","optn_menu_maps","optn_menu_maps_clickable","optn_menu_maps_rng_lvl"],glow_color_override:16701501,transformation:{left_rotation:[0f,0f,0f,1f],right_rotation:[0f,0f,0f,1f],translation:[0f,0f,0f],scale:[1f,1f,1f]},item:{id:"minecraft:oak_sign",count:1,components:{"minecraft:custom_model_data":{strings:["no"]}}}}
execute if score $block_same_map map_selection matches 1 at @e[tag=optn_menu_background,limit=1] run summon item_display ~0.5 ~1.9 ~1.765 {billboard:"fixed",item_display:"head",Tags:["optn_menu","optn_menu_maps","optn_menu_maps_clickable","optn_menu_maps_rng_lvl"],glow_color_override:16701501,transformation:{left_rotation:[0f,0f,0f,1f],right_rotation:[0f,0f,0f,1f],translation:[0f,0f,0f],scale:[1f,1f,1f]},item:{id:"minecraft:oak_sign",count:1,components:{"minecraft:custom_model_data":{strings:["yes"]}}}}

execute if score $block_same_map map_selection matches 1 run function lobby:option_panel/pages/maps/rng_lvl/cant_play_twice
execute if score $block_same_map map_selection matches 0 run function lobby:option_panel/pages/maps/rng_lvl/can_play_twice

            ## TIME CHANGE
execute if score $time_change option_panel matches 0 at @e[tag=optn_menu_background,limit=1] run summon item_display ~4.3 ~1.9 ~1.765 {billboard:"fixed",item_display:"head",Tags:["optn_menu","optn_menu_maps","optn_menu_maps_clickable","optn_menu_maps_time_change"],glow_color_override:16701501,transformation:{left_rotation:[0f,0f,0f,1f],right_rotation:[0f,0f,0f,1f],translation:[0f,0f,0f],scale:[1f,1f,1f]},item:{id:"minecraft:oak_sign",count:1,components:{"minecraft:custom_model_data":{strings:["no"]}}}}
execute if score $time_change option_panel matches 1 at @e[tag=optn_menu_background,limit=1] run summon item_display ~4.3 ~1.9 ~1.765 {billboard:"fixed",item_display:"head",Tags:["optn_menu","optn_menu_maps","optn_menu_maps_clickable","optn_menu_maps_time_change"],glow_color_override:16701501,transformation:{left_rotation:[0f,0f,0f,1f],right_rotation:[0f,0f,0f,1f],translation:[0f,0f,0f],scale:[1f,1f,1f]},item:{id:"minecraft:oak_sign",count:1,components:{"minecraft:custom_model_data":{strings:["yes"]}}}}

execute if score $time_change option_panel matches 1 run function lobby:option_panel/pages/maps/time_change/on
execute if score $time_change option_panel matches 0 run function lobby:option_panel/pages/maps/time_change/off


