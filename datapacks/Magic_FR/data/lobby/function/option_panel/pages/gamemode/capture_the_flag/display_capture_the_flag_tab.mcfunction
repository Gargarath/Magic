## appelée par display_gamemode_tab si on est en mode CTF
# permet d'afficher le menu -> mode de jeu CTF


execute unless score $gamemode option_panel matches 1 run function lobby:option_panel/pages/gamemode/capture_the_flag/set_ctf_mode
# si on est pas déjà en mode CTF -> passe le jeu en CTF

# clear menu
kill @e[type=interaction,tag=optn_menu_gamemode_clickable]
kill @e[type=item_display,tag=optn_menu_gamemode_clickable]
kill @e[type=text_display,tag=optn_menu_gamemode_clickable]

