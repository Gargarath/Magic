{
  "model": {
    "type": "select",
    "property": "custom_model_data",
    "fallback": {
      "type": "model",
      "model": "item/shears"
    },
    "cases": [
      {
        "when": "invisible",
        "model": {
          "type": "model",
          "model": "item/rogue/shears/invisible"
        }
      },
      {
        "when": "stealth_100",
        "model": {
          "type": "model",
          "model": "item/rogue/shears/stealth_100"
        }
      }
    ]
  }
}